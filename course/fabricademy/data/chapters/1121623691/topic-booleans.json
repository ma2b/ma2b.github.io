{
  "id": "topic-booleans",
  "title": "布尔运算、镜像与现场错误",
  "summary": "用 Bool Tool 演示差集、并集和交集，并保留切割及应用失败的现场情况。",
  "key_points": [
    "选择切割对象，再将目标物体设为活动对象，确认选择关系后执行布尔运算。",
    "Brush Boolean 保留可调整的切割对象；与立即应用的方式不同，不能把预览结果当作已固定几何。",
    "演示还用 Mirror 和参考对象建立对称附加形状。",
    "Slice 的结果并不清晰，Apply Cutter 随后报错且没有排除；本段不应当作已验证的平面切片或应用成功教程。"
  ],
  "terms": [
    {
      "term": "Difference / Union / Intersect",
      "definition": "差集去除重叠部分、并集合并体积、交集保留重叠部分。"
    },
    {
      "term": "切割对象",
      "definition": "用于决定目标几何增减区域的辅助物体。"
    }
  ],
  "actions": [
    "在模型副本上分别测试差集、并集和交集。",
    "应用前检查结果并保存版本；若出现错误，先核查活动对象和修改器状态。"
  ],
